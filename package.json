{
  "name": "euchre",
  "version": "1.0.0",
  "description": "Two-player online euchre with bot partners",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node server/selftest.js && node server/e2e.js",
    "test:rules": "node server/selftest.js",
    "test:e2e": "node server/e2e.js",
    "test:ui": "node server/uicheck.js",
    "test:tags": "node server/tagcheck.js",
    "test:cards": "node server/cardshots.js",
    "smoke": "node server/smoke-remote.js",
    "tune": "node server/tune.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
